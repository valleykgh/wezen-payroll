generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FACILITY_ADMIN
  FACILITY_STAFF
  PROFESSIONAL
  INTERNAL_ADMIN
}

enum ClinicianRole {
  CNA
  LVN
  RN
}

enum ShiftType {
  AM
  PM
  NOC
}

enum ShiftStatus {
  OPEN
  INVITE_ONLY
  PENDING
  FILLED
  COMPLETED
  UNFILLED
  CANCELLED
}

enum RequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  CANCELLATION_REQUESTED
  CANCELLED
  NO_SHOW
}

enum DocumentCategory {
  LICENSE
  CPR
  PHYSICAL
  TB_TEST
  TB_REPORT
  SSN
  STATE_ID
  ID
  VACCINATION
  BACKGROUND_CHECK
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  EXPIRED
  REJECTED
}

enum AgreementType {
  ICA
}

enum AgreementStatus {
  NOT_STARTED
  SENT
  SIGNED
}

enum NotificationType {
  SHIFT_APPROVED
  SHIFT_REJECTED
  DOCUMENT_REJECTED
  DNR_BLOCK
  GENERAL
}

enum StorageProvider {
  LOCAL
  ONEDRIVE
}

model User {
  workerCode                 String?   @unique
  id                         String   @id @default(cuid())
  email                      String   @unique
  passwordHash               String?
  role                       UserRole
  firstName                  String?
  lastName                   String?
  phone                      String?
  isActive                   Boolean  @default(true)
  isSystemUser               Boolean  @default(false)
  notificationEmail          String?
  notifyNewWorkerSignup      Boolean  @default(true)
  notifyDocumentUploads      Boolean  @default(true)
  notifyAgreementSigned      Boolean  @default(true)
  notifyWorkerReadyForReview Boolean  @default(true)
  appNotificationsEnabled    Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  facilityAdmin       FacilityAdmin?
  facilityStaff       FacilityStaff?
  professional        ProfessionalProfile?
  uploadedDocs        ProfessionalDocument[] @relation("UploadedBy")
  adminNotifications  AdminNotification[]
  deviceTokens        UserDeviceToken[]
  auditLogs           AdminAuditLog[]        @relation("AdminAuditActor")
  passwordResetTokens PasswordResetToken[]
}

model Facility {
  integrations            FacilityIntegration[]
  workerExternalMappings  WorkerExternalMapping[]
  externalWorkers         FacilityExternalWorker[]
  timecards               ShiftTimecard[]
  id                       String   @id @default(cuid())
  name                     String
  facilityType             String?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  state                    String?
  zipCode                  String?
  contactEmail             String?
  contactPhone             String?
  latitude                 Float?
  longitude                Float?
  defaultCnaRateCents      Int?
  defaultLvnRateCents      Int?
  defaultRnRateCents       Int?
  allowRateOverride        Boolean  @default(false)
  defaultAmStartTimeLabel  String?  @default("7:00 AM")
  defaultAmEndTimeLabel    String?  @default("3:30 PM")
  defaultPmStartTimeLabel  String?  @default("3:00 PM")
  defaultPmEndTimeLabel    String?  @default("11:30 PM")
  defaultNocStartTimeLabel String?  @default("11:00 PM")
  defaultNocEndTimeLabel   String?  @default("7:30 AM")
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  admins           FacilityAdmin[]
  staff            FacilityStaff[]
  notifications    FacilityNotification[]
  shiftInvitations ShiftInvitation[]
  shifts           Shift[]
  requirements     FacilityRequirement[]
  facilityDnrs     FacilityDnr[]
  invites          FacilityInvite[]
}

model FacilityAdmin {
  id         String   @id @default(cuid())
  userId     String   @unique
  facilityId String
  title      String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model FacilityStaff {
  id         String   @id @default(cuid())
  userId     String   @unique
  facilityId String
  title      String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
}

model ProfessionalProfile {
  workerExternalMappings  WorkerExternalMapping[]
  externalWorkers         FacilityExternalWorker[]
  timeExports             ShiftTimeExport[]
  timecards               ShiftTimecard[]
  id                        String        @id @default(cuid())
  userId                    String        @unique
  role                      ClinicianRole
  addressLine1              String?
  addressLine2              String?
  city                      String?
  state                     String?
  zipCode                   String?
  ssnLast4                  String?
  maxDistanceMiles          Int?          @default(25)
  openShiftAlertsEnabled    Boolean       @default(false)
  openShiftAlertRadiusMiles Int?          @default(50)
  hourlyRateCents           Int?
  regularPayRateCents       Int?
  overtimePayRateCents      Int?
  doublePayRateCents        Int?
  bio                       String?
  onboardingStatus          String?       @default("PENDING")
  approvedByWezen           Boolean       @default(false)
  latitude                  Float?
  longitude                 Float?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents        ProfessionalDocument[]
  requests         ShiftRequest[]
  agreements       ProfessionalAgreement[]
  facilityDnrs     FacilityDnr[]
  notifications    WorkerNotification[]
  shiftInvitations ShiftInvitation[]
  availabilities   WorkerAvailability[]
}

model ProfessionalDocument {
  id               String           @id @default(cuid())
  professionalId   String
  uploadedByUserId String?
  category         DocumentCategory
  name             String
  fileUrl          String
  storageProvider  StorageProvider  @default(LOCAL)
  oneDriveItemId   String?
  oneDriveWebUrl   String?
  oneDrivePath     String?
  oneDriveFolder   String?
  mimeType         String?
  status           DocumentStatus   @default(PENDING)
  expiresAt        DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  uploadedBy   User?               @relation("UploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
}

model FacilityRequirement {
  id         String           @id @default(cuid())
  facilityId String
  category   DocumentCategory
  isRequired Boolean          @default(true)
  createdAt  DateTime         @default(now())

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model ProfessionalAgreement {
  id             String          @id @default(cuid())
  professionalId String
  agreementType  AgreementType   @default(ICA)
  status         AgreementStatus @default(NOT_STARTED)
  signedAt       DateTime?
  signerName     String?
  signerEmail    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, agreementType])
}

model WorkerNotification {
  id             String           @id @default(cuid())
  professionalId String
  type           NotificationType
  title          String
  message        String
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model Shift {
  timeExports ShiftTimeExport[]
  timecards   ShiftTimecard[]
  id                  String        @id @default(cuid())
  facilityId          String
  role                ClinicianRole
  shiftType           ShiftType
  date                DateTime
  startTimeLabel      String
  endTimeLabel        String
  workersNeeded       Int           @default(1)
  specialInstructions String?
  payRateCents        Int?
  status              ShiftStatus   @default(OPEN)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  facility              Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  requests              ShiftRequest[]
  invitations           ShiftInvitation[]
  adminOverrideReason   String?
  adminOverrideByUserId String?
  adminOverrideAt       DateTime?
}

model ShiftRequest {
  id             String        @id @default(cuid())
  shiftId        String
  professionalId String
  status         RequestStatus @default(REQUESTED)
  requestedAt    DateTime      @default(now())
  reminderSentAt DateTime?
  reviewedAt     DateTime?
  reviewNotes    String?

  shift        Shift               @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([shiftId, professionalId])
}

model WorkerAvailability {
  id             String    @id @default(cuid())
  professionalId String
  date           DateTime
  shiftType      ShiftType
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, date, shiftType])
  @@index([date, shiftType])
  @@index([professionalId])
}

model ShiftInvitation {
  id             String    @id @default(cuid())
  shiftId        String
  professionalId String
  facilityId     String
  status         String    @default("SENT") // SENT, ACCEPTED, DECLINED, EXPIRED
  message        String?
  createdAt      DateTime  @default(now())
  respondedAt    DateTime?

  shift        Shift               @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  facility     Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([shiftId, professionalId])
  @@index([facilityId])
  @@index([professionalId])
}

model FacilityDnr {
  id             String   @id @default(cuid())
  facilityId     String
  professionalId String
  reason         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  facility     Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([facilityId, professionalId])
}

model FacilityInvite {
  id         String    @id @default(cuid())
  facilityId String
  inviteCode String    @unique
  email      String?
  isUsed     Boolean   @default(false)
  usedAt     DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model UserDeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FacilityNotification {
  id         String           @id @default(cuid())
  facilityId String
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
}

model AdminNotification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorEmail  String?
  action      String
  entityType  String
  entityId    String?
  summary     String
  detailsJson Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}


enum IntegrationProvider {
  UKG_READY
  UKG_DIMENSIONS
  UKG_PRO
  KRONOS
  CSV
  SFTP
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
}

model FacilityIntegration {
  id                String               @id @default(cuid())
  facilityId        String
  provider          IntegrationProvider
  status            IntegrationStatus    @default(INACTIVE)

  externalSystemName String?
  apiBaseUrl         String?
  clientId           String?
  encryptedSecret    String?
  configJson         Json?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  facility          Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  syncLogs          IntegrationSyncLog[]

  @@index([facilityId])
}

model IntegrationSyncLog {
  id                    String   @id @default(cuid())

  facilityIntegrationId String
  syncType              String
  status                String

  requestPayload        Json?
  responsePayload       Json?
  errorMessage          String?

  createdAt             DateTime @default(now())

  facilityIntegration   FacilityIntegration @relation(fields: [facilityIntegrationId], references: [id], onDelete: Cascade)

  @@index([facilityIntegrationId])
  @@index([createdAt])
}

model WorkerExternalMapping {
  id                    String   @id @default(cuid())

  professionalId        String
  facilityId            String

  externalEmployeeId    String
  externalDepartmentId  String?
  externalCostCenter    String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  professional          ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  facility              Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([professionalId, facilityId])
  @@index([externalEmployeeId])
}

model ShiftTimeExport {
  id                    String   @id @default(cuid())

  shiftId               String
  professionalId        String

  exported              Boolean  @default(false)
  exportedAt            DateTime?

  exportType            String?
  externalReference     String?

  createdAt             DateTime @default(now())

  professional          ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  shift                 Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([shiftId])
  @@index([exported])
}

model ShiftTimecard {
  id                    String   @id @default(cuid())

  shiftId               String
  professionalId        String
  facilityId            String

  clockInAt             DateTime?
  clockOutAt            DateTime?

  breakMinutes          Int      @default(0)

  regularHours          Float    @default(0)
  overtimeHours         Float    @default(0)
  doubletimeHours       Float    @default(0)

  approvedByWorkerAt    DateTime?
  approvedByFacilityAt  DateTime?

  workerNotes           String?
  facilityNotes         String?

  status                String   @default("PENDING")

  exportedAt            DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  shift                 Shift               @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  professional          ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  facility              Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([shiftId, professionalId])
  @@index([facilityId, status])
  @@index([professionalId])
}

model FacilityExternalWorker {
  id                    String   @id @default(cuid())

  facilityId            String
  professionalId        String

  externalSystem        String
  externalWorkerId      String

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  facility              Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  professional          ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([facilityId, professionalId, externalSystem])
  @@index([externalWorkerId])
}



