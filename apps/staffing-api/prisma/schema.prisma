generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FACILITY_ADMIN
  PROFESSIONAL
  INTERNAL_ADMIN
}

enum ClinicianRole {
  CNA
  LVN
  RN
}

enum ShiftType {
  AM
  PM
  NOC
}

enum ShiftStatus {
  OPEN
  PENDING
  FILLED
  COMPLETED
  UNFILLED
  CANCELLED
}

enum RequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  CANCELLATION_REQUESTED
  CANCELLED
  NO_SHOW
}

enum DocumentCategory {
  LICENSE
  CPR
  PHYSICAL
  TB_TEST
  TB_REPORT
  SSN
  STATE_ID
  ID
  VACCINATION
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  EXPIRED
  REJECTED
}

enum AgreementType {
  ICA
}

enum AgreementStatus {
  NOT_STARTED
  SENT
  SIGNED
}

enum NotificationType {
  SHIFT_APPROVED
  SHIFT_REJECTED
  DOCUMENT_REJECTED
  DNR_BLOCK
  GENERAL
}

enum StorageProvider {
  LOCAL
  ONEDRIVE
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  passwordHash  String?
  role          UserRole
  firstName     String?
  lastName      String?
  phone         String?
  isActive      Boolean             @default(true)
  isSystemUser  Boolean 	    @default(false)
  notificationEmail         String?
  notifyNewWorkerSignup     Boolean @default(true)
  notifyDocumentUploads     Boolean @default(true)
  notifyAgreementSigned     Boolean @default(true)
  notifyWorkerReadyForReview Boolean @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  facilityAdmin FacilityAdmin?
  professional  ProfessionalProfile?
  uploadedDocs  ProfessionalDocument[] @relation("UploadedBy")
  adminNotifications AdminNotification[]
  deviceTokens  UserDeviceToken[]
}

model Facility {
  id                    String         @id @default(cuid())
  name                  String
  facilityType          String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  zipCode               String?
  contactEmail          String?
  contactPhone          String?
  latitude              Float?
  longitude             Float?
  defaultCnaRateCents   Int?
  defaultLvnRateCents   Int?
  defaultRnRateCents    Int?
  allowRateOverride     Boolean        @default(false)
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  admins          FacilityAdmin[]
  notifications   FacilityNotification[]
  shifts          Shift[]
  requirements    FacilityRequirement[]
  facilityDnrs    FacilityDnr[]
  invites         FacilityInvite[]
}

model FacilityAdmin {
  id          String   @id @default(cuid())
  userId      String   @unique
  facilityId  String
  title       String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model ProfessionalProfile {
  id                 String                 @id @default(cuid())
  userId             String                 @unique
  role               ClinicianRole
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  zipCode            String?
  maxDistanceMiles   Int?                   @default(25)
  openShiftAlertsEnabled Boolean             @default(false)
  openShiftAlertRadiusMiles Int?             @default(50)
  hourlyRateCents    Int?
  regularPayRateCents Int?
  overtimePayRateCents Int?
  doublePayRateCents   Int?
  bio                String?
  onboardingStatus   String?                @default("PENDING")
  approvedByWezen    Boolean                @default(false)
  latitude	     Float?
  longitude  	     Float?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents          ProfessionalDocument[]
  requests           ShiftRequest[]
  agreements         ProfessionalAgreement[]
  facilityDnrs    FacilityDnr[]
  notifications     WorkerNotification[]
}

model ProfessionalDocument {
  id                String             @id @default(cuid())
  professionalId    String
  uploadedByUserId  String?
  category          DocumentCategory
  name              String
  fileUrl           String
  storageProvider   StorageProvider    @default(LOCAL)
  oneDriveItemId    String?
  oneDriveWebUrl    String?
  oneDrivePath      String?
  oneDriveFolder    String?
  mimeType          String?
  status            DocumentStatus     @default(PENDING)
  expiresAt         DateTime?
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  professional      ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  uploadedBy        User?               @relation("UploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
}

model FacilityRequirement {
  id          String           @id @default(cuid())
  facilityId  String
  category    DocumentCategory
  isRequired  Boolean          @default(true)
  createdAt   DateTime         @default(now())

  facility    Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model ProfessionalAgreement {
  id               String           @id @default(cuid())
  professionalId   String
  agreementType    AgreementType    @default(ICA)
  status           AgreementStatus  @default(NOT_STARTED)
  signedAt         DateTime?
  signerName       String?
  signerEmail      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  professional     ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, agreementType])
}
model WorkerNotification {
  id              String            @id @default(cuid())
  professionalId  String
  type            NotificationType
  title           String
  message         String
  isRead          Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}
model Shift {
  id                String         @id @default(cuid())
  facilityId        String
  role              ClinicianRole
  shiftType         ShiftType
  date              DateTime
  startTimeLabel    String
  endTimeLabel      String
  workersNeeded     Int            @default(1)
  specialInstructions String?
  payRateCents      Int?
  status            ShiftStatus    @default(OPEN)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  facility          Facility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  requests          ShiftRequest[]
  adminOverrideReason   String?
  adminOverrideByUserId String?
  adminOverrideAt       DateTime?
}

model ShiftRequest {
  id               String            @id @default(cuid())
  shiftId          String
  professionalId   String
  status           RequestStatus     @default(REQUESTED)
  requestedAt      DateTime          @default(now())
  reviewedAt       DateTime?
  reviewNotes      String?

  shift            Shift             @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  professional     ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([shiftId, professionalId])
}

model FacilityDnr {
  id              String   @id @default(cuid())
  facilityId      String
  professionalId  String
  reason          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facility        Facility             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  professional    ProfessionalProfile  @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([facilityId, professionalId])
}

model FacilityInvite {
  id             String   @id @default(cuid())
  facilityId      String
  inviteCode      String   @unique
  email           String?
  isUsed          Boolean  @default(false)
  usedAt          DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facility        Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}


model UserDeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model FacilityNotification {
  id         String   @id @default(cuid())
  facilityId String
  type       NotificationType
  title      String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
}

model AdminNotification {
  id        String   @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
