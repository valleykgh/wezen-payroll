"use client";

import React from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";

const primaryNav = [
  { href: "/admin", label: "Dashboard" },
  { href: "/admin/time-entry", label: "Time Entry" },
  { href: "/admin/time-entries-week", label: "Weekly Entries" },
  { href: "/admin/missed-time", label: "Exceptions" },
  { href: "/admin/pay-period-summary", label: "Pay Summary" },
  { href: "/admin/payroll-runs", label: "Payroll Runs" },
  { href: "/admin/payroll-adjustments", label: "Adjustments" },
];

const secondaryNav = [
  { href: "/admin/users", label: "Admin Users" },
  { href: "/admin/employees", label: "Employees" },
  { href: "/admin/employees/new", label: "Create Employee" },
  { href: "/admin/payroll-runs/new", label: "Finalize Payroll" },
  { href: "/admin/facilities", label: "Facilities" },
  { href: "/admin/loans", label: "Loans" },
  { href: "/admin/holidays", label: "Holidays" },
];

function NavLink({ href, label }: { href: string; label: string }) {
  const pathname = usePathname();
  const active = pathname === href || pathname.startsWith(href + "/");

  return (
    <Link
      href={href}
      className={
        active
          ? "inline-flex items-center rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-sm"
          : "inline-flex items-center rounded-full border border-slate-300 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-200 hover:text-slate-950"
	}
    >
      {label}
    </Link>
  );
}

async function handleLogout() {
  try {
    const apiBase =
      process.env.NEXT_PUBLIC_API_URL?.replace(/\/+$/, "") || "http://localhost:4000";

    await fetch(`${apiBase}/api/auth/logout`, {
      method: "POST",
      credentials: "include",
    });
  } catch {}

  localStorage.removeItem("payroll_user");
  window.location.href = "/admin/login";
}

export default function AdminLayoutClient({ children }: { children: React.ReactNode }) {
  return (
    <div className="min-h-screen bg-slate-50">
      <header className="border-b border-slate-200 bg-white">
        <div className="mx-auto max-w-7xl px-6 py-5">
          <div className="flex flex-col gap-5 xl:flex-row xl:items-start xl:justify-between">
            <div>
              <div className="text-sm font-semibold uppercase tracking-[0.22em] text-cyan-700">
                Payroll Admin
              </div>
              <h1 className="mt-2 text-2xl font-bold tracking-tight text-slate-950">
                Wezen Payroll Control Center
              </h1>
              <p className="mt-2 max-w-3xl text-sm text-slate-600">
                Manage time entry, payroll runs, employees, facilities, and payroll operations from one admin workspace.
              </p>
            </div>

            <div className="flex items-center gap-3">
              <a
                href="/"
                className="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 hover:text-slate-950"
              >
                Payroll Home
              </a>

              <button
                type="button"
                onClick={handleLogout}
                className="inline-flex items-center rounded-full bg-cyan-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-cyan-700"
              >
                Logout
              </button>
            </div>
          </div>

          <div className="mt-6">
