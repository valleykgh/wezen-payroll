{
  "family": "wezen-staffing-api-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::211125653940:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::211125653940:role/ecsTaskExecutionRole",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "staffing-api",
      "image": "211125653940.dkr.ecr.us-west-1.amazonaws.com/wezen-staffing-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4001,
          "hostPort": 4001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "4001"
        },
        {
          "name": "FRONTEND_URL",
          "value": "https://wezenstaffing.com"
        },
        {
          "name": "FRONTEND_URL_WWW",
          "value": "https://www.wezenstaffing.com"
        }
      ],
        "secrets": [
  {
    "name": "DATABASE_URL",
    "valueFrom": "arn:aws:ssm:us-west-1:211125653940:parameter/wezen/staffing/DATABASE_URL"
  },
  {
    "name": "JWT_SECRET",
    "valueFrom": "arn:aws:ssm:us-west-1:211125653940:parameter/wezen/staffing/JWT_SECRET"
  },
  {
    "name": "MS_TENANT_ID",
    "valueFrom": "arn:aws:ssm:us-west-1:211125653940:parameter/wezen/staffing/MS_TENANT_ID"
  },
  {
    "name": "MS_CLIENT_ID",
    "valueFrom": "arn:aws:ssm:us-west-1:211125653940:parameter/wezen/staffing/MS_CLIENT_ID"
  },
  {
    "name": "MS_CLIENT_SECRET",
    "valueFrom": "arn:aws:ssm:us-west-1:211125653940:parameter/wezen/staffing/MS_CLIENT_SECRET"
  },
  {
    "name": "MS_ONEDRIVE_USER",
    "valueFrom": "arn:aws:ssm:us-west-1:211125653940:parameter/wezen/staffing/MS_ONEDRIVE_USER"
  },
  {
    "name": "REMINDER_JOB_TOKEN",
    "valueFrom": "arn:aws:ssm:us-west-1:211125653940:parameter/wezen/staffing/REMINDER_JOB_TOKEN"
  }
],
	"logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/wezen-staffing-api",
          "awslogs-region": "us-west-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
